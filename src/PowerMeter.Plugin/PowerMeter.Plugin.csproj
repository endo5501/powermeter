<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>PowerMeter.Plugin</AssemblyName>
    <RootNamespace>PowerMeter.Plugin</RootNamespace>
    <Version>$(PowerMeterVersion)</Version>
    <!-- BepInEx プラグインは自前で依存を解決するので、依存 DLL の自動生成物は不要 -->
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- ゲーム側 DLL の XML ドキュメント欠如などの警告を抑制 -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- SDK 7 単体では net472 をビルドできないため参照アセンブリを取得する -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PowerMeter.Core\PowerMeter.Core.csproj" />
  </ItemGroup>

  <!-- ゲーム本体アセンブリ（配布物には含めない） -->
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(GameManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(GameManagedDir)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(GameManagedDir)\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(GameManagedDir)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(GameManagedDir)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(GameManagedDir)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- BepInEx / Harmony（r2modman プロファイルから直接参照。NuGet フィード設定不要） -->
  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExCoreDir)\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExCoreDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- ビルド後に r2modman プロファイルへ配置（DeployToProfile=false で無効化） -->
  <Target Name="DeployToBepInEx" AfterTargets="Build"
          Condition="'$(DeployToProfile)' == 'true' and '$(PluginDeployDir)' != '' and Exists('$(BepInExDir)')">
    <MakeDir Directories="$(PluginDeployDir)" />
    <Copy SourceFiles="$(TargetPath);$(TargetDir)PowerMeter.Core.dll" DestinationFolder="$(PluginDeployDir)" SkipUnchangedFiles="false" />
    <Message Importance="high" Text="PowerMeter -> $(PluginDeployDir)" />
  </Target>

  <!-- r2modman の「ローカル mod のインストール」で読める zip を作る -->
  <PropertyGroup>
    <RepoRoot>$(MSBuildThisFileDirectory)..\..\</RepoRoot>
    <PackagingDir>$(RepoRoot)packaging\</PackagingDir>
    <PackageStageDir>$(RepoRoot)artifacts\package\</PackageStageDir>
    <PackageOutputDir>$(RepoRoot)artifacts\</PackageOutputDir>
    <PackageFileName>endo5501-PowerMeter-$(PowerMeterVersion).zip</PackageFileName>
  </PropertyGroup>

  <Target Name="Package" DependsOnTargets="Build">
    <Error Condition="'$(Configuration)' != 'Release'"
           Text="配布用 zip は Release 構成で作成してください: dotnet build -c Release -t:Package" />

    <!-- manifest.json のバージョンが取り残されるのを防ぐ -->
    <PropertyGroup>
      <ManifestText>$([System.IO.File]::ReadAllText('$(PackagingDir)manifest.json'))</ManifestText>
    </PropertyGroup>
    <Error Condition="!$(ManifestText.Contains('&quot;version_number&quot;: &quot;$(PowerMeterVersion)&quot;'))"
           Text="packaging/manifest.json の version_number が $(PowerMeterVersion) と一致しません。" />

    <RemoveDir Directories="$(PackageStageDir)" />
    <MakeDir Directories="$(PackageStageDir)" />

    <!--
      README のスクリーンショットは同梱しない。zip の大半を占めるうえ、
      Thunderstore も r2modman も README 内の相対パス画像は解決しないため。
    -->
    <Copy SourceFiles="$(PackagingDir)manifest.json;$(PackagingDir)icon.png;$(RepoRoot)README.md;$(RepoRoot)README-ja.md;$(RepoRoot)LICENSE"
          DestinationFolder="$(PackageStageDir)" />
    <Copy SourceFiles="$(TargetPath);$(TargetDir)PowerMeter.Core.dll" DestinationFolder="$(PackageStageDir)" />

    <MakeDir Directories="$(PackageOutputDir)" />
    <Delete Files="$(PackageOutputDir)$(PackageFileName)" />
    <ZipDirectory SourceDirectory="$(PackageStageDir)" DestinationFile="$(PackageOutputDir)$(PackageFileName)" />
    <Message Importance="high" Text="package -> $(PackageOutputDir)$(PackageFileName)" />
  </Target>

</Project>
